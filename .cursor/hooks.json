{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "python3 hooks/cloud_roster_guard.py",
        "matcher": "Task",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "python3 hooks/cloud_roster_guard.py",
        "loop_limit": 2,
        "timeout": 5
      }
    ]
  }
}
