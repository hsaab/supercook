{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "python3 -B \"${CURSOR_PLUGIN_ROOT}/scripts/launch_log.py\"",
        "matcher": "Task|Subagent|CreateAgent|CallDynamicTool",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "python3 -B \"${CURSOR_PLUGIN_ROOT}/scripts/ledger_followup.py\"",
        "loop_limit": 2,
        "timeout": 5
      }
    ]
  }
}
